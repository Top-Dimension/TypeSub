{
  "name": "typesub",
  "version": "0.1.2",
  "description": "TypeSub - offline speech recognition and live OBS captions",
  "homepage": "https://github.com/Top-Dimension/TypeSub",
  "main": "electron/main.cjs",
  "author": "TypeSub <contact@tpdsite.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:engine": "cargo build --manifest-path rust/Cargo.toml --release",
    "build:ui": "node scripts/build-ui.cjs",
    "test:app": "node --test tests/*.test.cjs",
    "test:engine": "cargo test --manifest-path rust/Cargo.toml",
    "start": "npm run build:engine && npm run build:ui && electron .",
    "dev": "npm run build:engine && npm run build:ui && electron .",
    "pack": "npm run build:engine && npm run build:ui && electron-builder --dir",
    "dist:setup": "npm run build:engine && npm run build:ui && node scripts/build-windows-setup.cjs",
    "dist:windows": "npm run dist:setup",
    "dist:linux": "npm run build:engine && electron-builder --linux AppImage deb --x64",
    "dist": "npm run build:engine && npm run build:ui && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.typesub.desktop",
    "productName": "TypeSub",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron/**/*",
      "!electron/camera-component.cjs",
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**"
    ],
    "win": {
      "extraResources": [
        {
          "from": "rust/target/release/typesub-engine.exe",
          "to": "typesub-engine.exe"
        },
        {
          "from": "rust/target/release/typesub-elevate.exe",
          "to": "typesub-elevate.exe"
        },
        {
          "from": "windows/publish",
          "to": "winui"
        }
      ],
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "TypeSub-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "TypeSub uses the microphone to generate live captions on this computer."
      },
      "extraResources": [
        {
          "from": "rust/target/release/typesub-engine",
          "to": "typesub-engine"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "extraResources": [
        {
          "from": "rust/target/release/typesub-engine",
          "to": "typesub-engine"
        }
      ]
    },
    "appImage": {
      "artifactName": "TypeSub-${version}-${arch}.${ext}"
    },
    "deb": {
      "afterInstall": "packaging/linux/after-install.sh",
      "depends": [
        "libc6 (>= 2.34)",
        "libgtk-3-0t64 | libgtk-3-0",
        "libasound2t64 | libasound2",
        "libnotify4",
        "libnss3",
        "libgbm1",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "tar",
        "bzip2"
      ]
    },
    "nsis": {
      "artifactName": "TypeSub-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "TypeSub-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@primno/dpapi": "^2.0.1",
    "sherpa-onnx-node": "2.0.2"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
