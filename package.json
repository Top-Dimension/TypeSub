{
  "name": "typesub",
  "version": "0.1.2",
  "description": "TypeSub - offline speech recognition and live OBS captions",
  "main": "electron/main.cjs",
  "author": "TypeSub",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:engine": "cargo build --manifest-path rust/Cargo.toml --release",
    "test:app": "node --test tests/*.test.cjs",
    "test:engine": "cargo test --manifest-path rust/Cargo.toml",
    "start": "npm run build:engine && electron .",
    "dev": "npm run build:engine && electron .",
    "pack": "npm run build:engine && electron-builder --dir",
    "dist:setup": "npm run build:engine && electron-builder --win nsis --x64",
    "dist": "npm run build:engine && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.typesub.desktop",
    "productName": "TypeSub",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron/**/*",
      "!electron/camera-component.cjs",
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": ["node_modules/sherpa-onnx-*/**"],
    "win": {
      "extraResources": [
        { "from": "rust/target/release/typesub-engine.exe", "to": "typesub-engine.exe" },
        { "from": "rust/target/release/typesub-elevate.exe", "to": "typesub-elevate.exe" }
      ],
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "TypeSub-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "TypeSub uses the microphone to generate live captions on this computer."
      },
      "extraResources": [
        { "from": "rust/target/release/typesub-engine", "to": "typesub-engine" }
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo",
      "extraResources": [
        { "from": "rust/target/release/typesub-engine", "to": "typesub-engine" }
      ]
    },
    "nsis": {
      "artifactName": "TypeSub-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "TypeSub-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "sherpa-onnx-node": "2.0.2"
  }
}
